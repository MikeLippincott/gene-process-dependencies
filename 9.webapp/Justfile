set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

default:
    just --list

download-data:
    python download_data.py

create-uv-env:
    uv venv .venv ; uv sync

build:
    uv run streamlit run app.py

deploy:
    PORT="${PORT:-8501}" uv run streamlit run app.py --server.address 0.0.0.0 --server.headless true --server.port "$PORT" --server.fileWatcherType none

all: create-uv-env build
